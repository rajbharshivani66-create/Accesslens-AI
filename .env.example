# Copy this file to .env at the repository root and fill in values from Supabase.
# Never commit .env or place server credentials in NEXT_PUBLIC_* variables.

# Browser Supabase Auth configuration (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API base URL used by the Next.js browser app.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Prisma runtime pooler URL (Supabase pooler, transaction/session mode as appropriate).
DATABASE_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct PostgreSQL URL used by Prisma migrations.
DIRECT_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres

# Backend token verification uses the Supabase project URL and public anon key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional server-only invitation email delivery (Resend).
# Leave both blank to use manually shareable invitation links only.
RESEND_API_KEY=
INVITATION_FROM_EMAIL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=
JIRA_TOKEN_ENCRYPTION_KEY=

# Backend CORS allow-list and HTTP port.
FRONTEND_URL=http://localhost:3000
PORT=4000

# Backend API rate limiting. Development/test may omit Redis and use process-local counters.
# Production requires a shared Redis/Valkey-compatible service.
RATE_LIMIT_REDIS_URL=
# Optional comma-separated proxy IPs/CIDRs. Only list ingress proxies you control.
# Leave blank to ignore all forwarded-IP headers and use the direct peer address.
TRUSTED_PROXY_CIDRS=
# Defaults: API 300/15m, auth API 30/15m, authenticated API 600/15m,
# writes 60/15m, invitations 5/1h, expensive operations 10/1m.
# Override with RATE_LIMIT_{API,AUTH,USER,WRITE,INVITATION,EXPENSIVE}_{MAX,WINDOW_MS}.
# Scanner limits: SCAN_MAX_PAGES (default 5, maximum 25), SCAN_PAGE_TIMEOUT_MS
# (default 15000, maximum 30000), SCAN_MAX_REQUESTS_PER_PAGE (default 100, maximum 500),
# SCAN_MAX_BYTES_PER_SCAN (default 25000000, maximum 200000000), and
# SCAN_MAX_CONCURRENT (default 1, maximum 4 per API instance).

# Development-only Visual Agent switch. Requires NODE_ENV=development and an explicit opt-in.
NEXT_PUBLIC_VISUAL_AGENT_ENABLED=false
RESEND_API_KEY=
INVITATION_FROM_EMAIL=onboarding@resend.dev