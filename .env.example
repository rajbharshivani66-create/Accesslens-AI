# Copy this file to .env at the repository root and fill in values from Supabase.
# Never commit .env or place server credentials in NEXT_PUBLIC_* variables.

# Browser Supabase Auth configuration (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API base URL used by the Next.js browser app.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Prisma runtime pooler URL (Supabase pooler, transaction/session mode as appropriate).
DATABASE_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct PostgreSQL URL used by Prisma migrations.
DIRECT_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres

# Backend token verification uses the Supabase project URL and public anon key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend CORS allow-list and HTTP port.
FRONTEND_URL=http://localhost:3000
PORT=4000

# Development-only Visual Agent switch; not used by the production application.
VISUAL_AGENT_ENABLED=false
