generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model UserProfile {
  id             String          @id @default(cuid())
  authUserId     String          @unique
  email          String          @unique
  fullName       String?
  avatarUrl      String?
  role           String          @default("member")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  projects       Project[]
  teams          TeamMember[]
  notifications  Notification[]
  activityLogs   ActivityLog[]
  jiraIntegrations JiraIntegration[]

  @@index([email])
}

model Team {
  id          String        @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     TeamMember[]
  projects    Project[]
}

model TeamMember {
  id        String      @id @default(cuid())
  teamId    String
  userId    String
  role      String      @default("member")
  createdAt DateTime    @default(now())
  team      Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Project {
  id          String    @id @default(cuid())
  ownerId     String
  teamId      String?
  name        String
  url         String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner       UserProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  team        Team?      @relation(fields: [teamId], references: [id])
  scans       Scan[]

  @@index([ownerId])
  @@index([teamId])
  @@unique([ownerId, name])
}

model Scan {
  id          String       @id @default(cuid())
  projectId   String
  status      String       @default("queued")
  score       Int          @default(0)
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings    Finding[]
  verificationRuns VerificationRun[]

  @@index([projectId])
}

model Finding {
  id          String          @id @default(cuid())
  scanId      String
  title       String
  description String?
  severity    String          @default("moderate")
  status      String          @default("open")
  selector    String?
  snippet     String?
  pageUrl     String?
  wcag        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  scan        Scan            @relation(fields: [scanId], references: [id], onDelete: Cascade)
  aiExplanation AIExplanation?
  fixSuggestion FixSuggestion?
  jiraIssue   JiraIssue?
  verificationRuns VerificationRun[]

  @@index([scanId])
  @@index([severity])
  @@index([status])
}

model AIExplanation {
  id          String   @id @default(cuid())
  findingId   String   @unique
  summary     String
  detail      String
  affectedUsers String[]
  wcag        String[]
  fixSteps    String[]
  createdAt   DateTime @default(now())
  finding     Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
}

model FixSuggestion {
  id          String   @id @default(cuid())
  findingId   String   @unique
  before      String
  after       String
  explanation String
  accepted    Boolean  @default(false)
  createdAt   DateTime @default(now())
  finding     Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
}

model VerificationRun {
  id          String   @id @default(cuid())
  scanId      String
  findingId   String?
  status      String   @default("completed")
  resolvedCount Int     @default(0)
  regressionCount Int   @default(0)
  scoreDelta  Int      @default(0)
  createdAt   DateTime @default(now())
  scan        Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  finding     Finding? @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@index([scanId])
  @@index([findingId])
}

model JiraIntegration {
  id          String       @id @default(cuid())
  userId      String
  baseUrl     String
  projectKey  String
  accessToken String?
  refreshToken String?
  connectedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        UserProfile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  issues      JiraIssue[]

  @@unique([userId, projectKey])
  @@index([userId])
}

model JiraIssue {
  id             String          @id @default(cuid())
  integrationId   String
  findingId       String?         @unique
  jiraKey         String          @unique
  title           String
  status          String          @default("Open")
  url             String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  integration     JiraIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  finding         Finding?        @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@index([integrationId])
  @@index([status])
}

model Notification {
  id        String      @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  read      Boolean     @default(false)
  createdAt DateTime    @default(now())
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model ActivityLog {
  id          String      @id @default(cuid())
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  details     String?
  createdAt   DateTime    @default(now())
  user        UserProfile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
