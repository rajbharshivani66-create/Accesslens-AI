generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  MEMBER
  ADMIN
}

enum ScanStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ScanPageStatus {
  COMPLETED
}

enum FindingSeverity {
  CRITICAL
  SERIOUS
  MODERATE
  MINOR
}

enum FindingStatus {
  OPEN
  IN_REVIEW
  IGNORED
  RESOLVED
}

enum FixSuggestionStatus {
  SUGGESTED
  ACCEPTED
  REJECTED
}

enum VerificationStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum VerificationOutcome {
  RESOLVED
  REMAINING
  REGRESSED
}

enum TeamMemberRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

enum InvitationEmailStatus {
  NOT_CONFIGURED
  PENDING
  ACCEPTED
  FAILED
}

enum NotificationType {
  SCAN_COMPLETED
  CRITICAL_ISSUE_DETECTED
  JIRA_ISSUE_CREATED
  VERIFICATION_COMPLETED
  PROJECT_ACTIVITY
}

model UserProfile {
  id               String           @id @default(cuid())
  authUserId       String           @unique @db.Uuid
  email            String           @unique
  fullName         String?
  avatarUrl        String?
  role             UserRole         @default(MEMBER)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  projects         Project[]
  teamMemberships  TeamMember[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  jiraIntegrations JiraIntegration[]
  jiraOAuthStates  JiraOAuthState[]
  sentTeamInvitations TeamInvitation[] @relation("TeamInvitationCreator")
  requestedScans   Scan[]            @relation("ScanRequester")
  assignedFindings Finding[]         @relation("FindingAssignee")

  @@index([email])
}

model Team {
  id          String       @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TeamMember[]
  invitations TeamInvitation[]
  projects    Project[]
}

model TeamInvitation {
  id          String       @id @default(cuid())
  teamId      String
  email       String
  tokenHash   String       @unique
  createdById String
  role        TeamMemberRole @default(DEVELOPER)
  emailStatus InvitationEmailStatus @default(NOT_CONFIGURED)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime     @default(now())
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   UserProfile  @relation("TeamInvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([teamId, expiresAt])
  @@index([createdById, createdAt])
}

model TeamMember {
  id        String         @id @default(cuid())
  teamId    String
  userId    String
  role      TeamMemberRole @default(VIEWER)
  createdAt DateTime       @default(now())
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Project {
  id          String      @id @default(cuid())
  ownerId     String
  teamId      String?
  name        String
  url         String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  owner       UserProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  team        Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  scans       Scan[]

  @@unique([ownerId, name])
  @@index([ownerId, createdAt])
  @@index([teamId])
}

model Scan {
  id                String             @id @default(cuid())
  projectId         String
  requestedById     String?
  status            ScanStatus         @default(QUEUED)
  score             Int                @default(0)
  startedAt         DateTime           @default(now())
  completedAt       DateTime?
  errorMessage      String?
  pageCount         Int                @default(1)
  incompleteCount   Int                @default(0)
  passedCount       Int                @default(0)
  durationMs        Int?
  requestedPaths    String[]           @default(["/"])
  verificationForFindingId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy       UserProfile?       @relation("ScanRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  findings          Finding[]
  pages             ScanPage[]
  verificationRuns  VerificationRun[]
  verificationFor   Finding?           @relation("VerificationTarget", fields: [verificationForFindingId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([projectId, startedAt])
  @@index([projectId, completedAt])
  @@index([status])
  @@index([status, startedAt])
  @@index([requestedById])
  @@index([verificationForFindingId])
}

model ScanPage {
  id             String         @id @default(cuid())
  scanId         String
  requestedUrl   String
  finalUrl       String
  title          String?
  status         ScanPageStatus @default(COMPLETED)
  durationMs     Int            @default(0)
  passedCount    Int            @default(0)
  incompleteCount Int           @default(0)
  createdAt      DateTime       @default(now())
  scan           Scan           @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, requestedUrl])
  @@index([scanId, createdAt])
}

model Finding {
  id                String              @id @default(cuid())
  scanId            String
  title             String
  ruleId            String              @default("unknown")
  description       String?
  impact            String?
  severity          FindingSeverity     @default(MODERATE)
  status            FindingStatus       @default(OPEN)
  assignedToId      String?
  selector          String?
  snippet           String?
  pageUrl           String?
  wcag              String?
  wcagTags          String[]            @default([])
  helpUrl           String?
  failureSummary    String?
  violationCount    Int                 @default(1)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  scan              Scan                @relation(fields: [scanId], references: [id], onDelete: Cascade)
  assignedTo        UserProfile?        @relation("FindingAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  aiExplanation     AIExplanation?
  fixSuggestion     FixSuggestion?
  jiraIssue         JiraIssue?
  verificationRuns  VerificationRun[]
  verificationScans Scan[]             @relation("VerificationTarget")

  @@index([scanId, createdAt])
  @@index([severity, status])
  @@index([assignedToId, status])
}

model AIExplanation {
  id            String   @id @default(cuid())
  findingId     String   @unique
  summary       String
  detail        String
  affectedUsers String[]
  wcag          String[]
  fixSteps      String[]
  rootCause     String?
  wcagExplanation String?
  testInstructions String[] @default([])
  createdAt     DateTime @default(now())
  finding       Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
}

model FixSuggestion {
  id          String              @id @default(cuid())
  findingId   String              @unique
  before      String
  after       String
  htmlSuggestion String?
  jsxSuggestion String?
  explanation String
  status      FixSuggestionStatus @default(SUGGESTED)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  finding     Finding             @relation(fields: [findingId], references: [id], onDelete: Cascade)
}

model VerificationRun {
  id              String             @id @default(cuid())
  scanId          String
  findingId       String?
  status          VerificationStatus @default(COMPLETED)
  outcome         VerificationOutcome?
  ruleId          String?
  title           String?
  pageUrl         String?
  resolvedCount   Int                @default(0)
  regressionCount Int                @default(0)
  scoreDelta      Int                @default(0)
  createdAt       DateTime           @default(now())
  scan            Scan               @relation(fields: [scanId], references: [id], onDelete: Cascade)
  finding         Finding?           @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@index([scanId, createdAt])
  @@index([findingId])
  @@index([status, createdAt])
}

model JiraIntegration {
  id                  String       @id @default(cuid())
  userId              String
  cloudId             String?
  baseUrl             String
  projectKey          String
  accessTokenCiphertext String?
  refreshTokenCiphertext String?
  accessTokenExpiresAt DateTime?
  scopes              String[]     @default([])
  connectedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  user                UserProfile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  issues              JiraIssue[]

  @@unique([userId, cloudId])
  @@index([userId])
}

model JiraOAuthState {
  id                       String      @id @default(cuid())
  userId                   String
  stateHash                String      @unique
  accessTokenCiphertext    String?
  refreshTokenCiphertext   String?
  accessTokenExpiresAt     DateTime?
  sites                    Json?
  expiresAt                DateTime
  callbackUsedAt           DateTime?
  completedAt              DateTime?
  consumedAt               DateTime?
  createdAt                DateTime    @default(now())
  user                     UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model JiraIssue {
  id            String          @id @default(cuid())
  integrationId String
  findingId     String?         @unique
  jiraKey       String          @unique
  title         String
  status        String          @default("Open")
  url           String?
  lastSyncedAt  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  integration   JiraIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  finding       Finding?        @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@index([integrationId])
  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      UserProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model ActivityLog {
  id         String       @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  details    Json?
  createdAt  DateTime     @default(now())
  user       UserProfile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}
