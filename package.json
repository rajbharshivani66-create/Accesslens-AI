{
  "name": "accesslens-ai",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "devtools/*"
  ],
  "scripts": {
    "dev": "pnpm db:generate && turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "pnpm db:generate && vitest run",
    "typecheck": "pnpm db:generate && turbo run typecheck",
    "db:generate": "pnpm --filter @accesslens-ai/database prisma:generate",
    "db:validate": "pnpm --filter @accesslens-ai/database prisma:validate",
    "db:migrate": "pnpm --filter @accesslens-ai/database prisma:migrate",
    "remove": "node scripts/remove-visual-agent.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "turbo": "^2.3.3",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
